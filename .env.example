# ==========================================================
# SJSU IT Front Desk RAG Agent - Environment Variables Template
# ==========================================================
# Copy this file to .env in each subfolder and fill in real values:
#   cp .env.example sjsu-confluence-ingest/.env
#   cp .env.example sjsu-it-agent/.env
# Never commit .env files - they contain operational config.
# ==========================================================

# === GCP project configuration ===
PROJECT_ID=your-gcp-project-id
LOCATION=us-west1

# === Confluence ingestion (via Application Integration) ===
INTEGRATION_NAME=your-integration-name
TRIGGER_ID=your-trigger-id
DOMAIN_URL=https://your-org.atlassian.net
SPACE_KEY=YOUR_SPACE_KEY

# === Google Cloud Storage ===
GCS_BUCKET=your-bucket-name
GCS_PREFIX=confluence

# === Vertex AI RAG corpus ===
RAG_CORPUS_ID=your-corpus-id-number
GEMINI_MODEL=gemini-2.5-flash

# === Google Sheet for Q&A overrides ===
SHEET_ID=your-google-sheet-id
SHEET_RANGE=Sheet1!A:E

# === Local development paths ===
OUTPUT_DIR=./output

# === Test/development flags (optional) ===
# SHEET_TEST_MODE=false
